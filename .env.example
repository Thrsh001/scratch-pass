SECRET_KEY=change-me-generate-a-new-django-secret-key
DEBUG=True
ALLOWED_HOSTS=

# Social login (optional). Leave blank to keep that provider's button
# disabled. See README "Social login" for how to get these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# PostgreSQL (optional). Leave POSTGRES_DB blank to use the local SQLite
# file. See README "PostgreSQL".
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
